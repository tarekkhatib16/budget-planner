# Local development (SQLite file in backend/)
DATABASE_URL=sqlite:///./budget.db

# Supabase Postgres: use the SESSION POOLER connection string from
# Dashboard -> Connect. The direct connection is IPv6-only and unreachable
# from most hosts (including Render's free tier).
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Signs login tokens. REQUIRED in production — generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=insecure-dev-only-secret-change-in-production

# How long a login stays valid
ACCESS_TOKEN_EXPIRE_DAYS=30

# Comma-separated origins allowed to call the API from a browser. Only
# needed if the frontend is served from a different origin than the API.
CORS_ORIGINS=http://localhost:5173
